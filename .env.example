# Application Settings
PROJECT_NAME="Intelligent Document Processing Platform"
VERSION="1.0.0"
API_V1_STR="/api/v1"
DEBUG=True
SECRET_KEY="dev_super_secret_key_change_in_production_min_32_bytes_long"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=idp_user
POSTGRES_PASSWORD=idp_password
POSTGRES_DB=idp_db
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}
SYNC_DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis & Celery
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0
CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/1
CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/2

# MinIO / Object Storage
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_DOCUMENTS=idp-documents
MINIO_BUCKET_ARTIFACTS=idp-artifacts
MINIO_USE_SSL=False

# AI & OCR Settings
DEFAULT_OCR_PROVIDER=tesseract  # tesseract | easyocr | fallback
DEFAULT_LLM_PROVIDER=local       # openai | gemini | local
DEFAULT_EMBEDDING_PROVIDER=local # openai | sentence_transformers | local

# Optional API Keys (Leave blank to use local fallback providers)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Processing & Confidence Thresholds
AUTO_APPROVE_THRESHOLD=0.90
HUMAN_REVIEW_THRESHOLD=0.70
